PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tourguardian

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Real AI chatbot (Claude API). Get a key at https://console.anthropic.com
# If left blank, TourGuardian automatically falls back to its built-in
# rule-based safety assistant — no key required to run the app.
ANTHROPIC_API_KEY=
